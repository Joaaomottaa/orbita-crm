  "nodes": [
    {
      "id": "c4743ab7-6b41-40b2-b6f2-d929d5cf56bc",
      "name": "Mensagem no WhatsApp oficial",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "updates": [
