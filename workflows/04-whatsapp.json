    {
      "id": "9b561f93-2e3a-40c2-a4f3-938904f7d687",
      "name": "Separar mensagens e normalizar telefone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const root=$json;const values=root.entry?root.entry.flatMap(e=>(e.changes||[]).map(c=>c.value)): [root];\nconst out=[];for(const v of values){for(const m of v.messages||[]){if(!m.from||!m.id)continue;out.push({json:{channel:'whatsapp',external_id:String(m.from),event_key:'wa:'+m.id,phone:'+'+String(m.from).replace(/\\D/g,''),name:null,text:m.text?.body||'[Mídia recebida: solicitar mensagem de texto]'}});}}return out;"
      }
    },
    {
      "id": "143c3a37-ddef-43fe-829b-78f13c4e7f58",
      "name": "Registrar mensagem no CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://urgwupjlpoerkdkfunti.supabase.co/functions/v1/orbita-automation",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({action:\"ingest\",data:$json}) }}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "bda22c73-f1bb-4cc1-968f-ab83c1462d71",
      "name": "Somente atendimento automático",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        672,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.action }}",
              "rightValue": "qualify",
              "operator": {
