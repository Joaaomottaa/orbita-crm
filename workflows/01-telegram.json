    {
      "id": "a9c3ff01-c3cc-44d0-a442-66b60dbae5dc",
      "name": "Identificar contato próprio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const u=$json,m=u.message;if(!m||m.chat?.type!=='private'||m.from?.is_bot)return null;\nconst c=m.contact; const own=c&&String(c.user_id)===String(m.from.id);\nconst phone=own?'+'+String(c.phone_number).replace(/\\D/g,''):null;\nreturn {json:{channel:'telegram',external_id:String(m.chat.id),event_key:'tg:'+String(u.update_id),phone,name:own?[c.first_name,c.last_name].filter(Boolean).join(' '):null,text:m.text||(own?'[Contato compartilhado]':'[Mensagem sem texto; pedir texto ao lead]')}};"
      }
    },
    {
      "id": "b9df0328-f9df-4c8c-8ae1-22ec1a86ee1e",
      "name": "Registrar mensagem no CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        96
      ],
      "parameters": {
        "method": "POST",
        "url": "https://urgwupjlpoerkdkfunti.supabase.co/functions/v1/orbita-automation",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({action:\"ingest\",data:$json}) }}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "943aeb01-218e-4045-a51b-eac9745f2b21",
      "name": "Precisa compartilhar telefone?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        672,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.action }}",
              "rightValue": "request_contact",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "7faf7b95-dfea-442d-8899-f2b6ac1fff63",
      "name": "Pedir contato no Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        896,
