      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.external_id }}",
        "text": "Olá! Sou a assistente virtual da Órbita. Para identificar seu cadastro e não duplicar contatos, compartilhe seu telefone no botão abaixo. Usaremos os dados para este atendimento comercial. Você pode pedir para parar ou falar com uma pessoa a qualquer momento.",
        "replyMarkup": "replyKeyboard",
        "replyKeyboard": {
          "rows": [
            {
              "row": {
