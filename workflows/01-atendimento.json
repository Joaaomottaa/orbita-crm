    {
      "id": "46c405ff-80c0-41d3-84d8-4628ca181a61",
      "name": "Contrato de extração",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1480,
        380
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"reply\":{\"type\":\"string\"},\"summary\":{\"type\":\"string\"},\"offer_meeting\":{\"type\":\"boolean\"},\"extracted\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":[\"string\",\"null\"]},\"company\":{\"type\":[\"string\",\"null\"]},\"email\":{\"type\":[\"string\",\"null\"]},\"need\":{\"type\":[\"string\",\"null\"]},\"fit\":{\"type\":[\"boolean\",\"null\"]},\"urgency\":{\"type\":[\"string\",\"null\"]},\"decision\":{\"type\":[\"string\",\"null\"]}},\"additionalProperties\":false},\"evidence\":{\"type\":\"object\",\"additionalProperties\":{\"type\":\"string\"}}},\"required\":[\"reply\",\"summary\",\"offer_meeting\",\"extracted\",\"evidence\"],\"additionalProperties\":false}",
        "autoFix": false
      }
    },
    {
      "id": "e71d0b2b-11e9-47b1-9637-d76d169a938b",
      "name": "Validar evidências e resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx=$('Contexto do atendimento').item.json;\ntry {\n const result=typeof $json.output==='string'?JSON.parse($json.output):$json.output;\n if(!result||typeof result.reply!=='string'||!result.reply.trim()||result.reply.length>3500)throw new Error('Saída inválida');\n const current=[ctx.message,...(ctx.context||[]).filter(m=>m.author==='lead').map(m=>m.body)].join('\\n').toLowerCase(),clean={},evidence={};\n for(const key of ['name','company','email','need','fit','urgency','decision']){\n const val=result.extracted?.[key],quote=result.evidence?.[key];\n if(val==null)continue;\n if(typeof quote!=='string'||quote.trim().length<2||!current.includes(quote.trim().toLowerCase()))continue;\n if(key==='fit'&&typeof val!=='boolean')continue;\n if(key==='urgency'&&!['30_days','later','unknown'].includes(val))continue;\n if(key==='decision'&&!['decision_maker','involved','unknown'].includes(val))continue;\n if(key!=='fit'&&(typeof val!=='string'||val.length>500))continue;\n clean[key]=val;evidence[key]=quote;\n }\n if(/garantimos|garantido|reunião (?:está )?confirmada|reunião marcada|desconto de|custa\\s*r?\\$|economia de\\s*\\d/i.test(result.reply))throw new Error('Promessa não autorizada');\n return [{json:{phone:ctx.phone,revision:ctx.revision,extracted:clean,evidence,summary:String(result.summary||'').slice(0,1000),reply:result.reply,offer_meeting:result.offer_meeting===true}}];\n}catch(e){return [{json:{phone:ctx.phone,failed:true,error:e.message}}]}"
      }
    },
